<div class="infobox-desktop">{% wiki-aside character %}</div>
<details class="infobox-mobile"><summary class="theme__block--primary">Details</summary>{% wiki-aside character %}</details>
<p>
    {% block intro %}{% endblock %}
</p>
<div class="summary">
    <div class="summary-title"><span class="summary-title-txt">Table of Contents</span></div>
    <div class="summary-content">
        <a href="#backstory">1. Backstory</a>
        <a href="#personality">2. Personality</a>
        <a href="#appearance">3. Appearance</a>
        <div class="sub-summary">
            <a href="#unique">3.1. Unique markings</a>
        </div>
        <a href="#skills">4. Skills and abilities</a>
        <a href="#trivia">5. Trivia</a>
    </div>
</div>
<h2 id="#backstory">Backstory</h2>
{% block backstory %}{% endblock %}
<h2 id="#personality">Personality</h2>
{% block personality %}{% endblock %}
<h2 id="#appearance">Appearance</h2>
{% block appearance %}{% endblock %}
<h3 id="#unique">Unique characteristics</h3>
{% block unique %}{% endblock %}
<h2 id="#skills">Skills and abilities</h2>
{% block skills %}{% endblock %}
<h2 id="#trivia">Trivia</h2>
{% block trivia %}{% endblock %}
<h2 id="#meta">Meta</h2>
{% block meta %}{% endblock %}
<span style="clear: both; display:block;"></span>